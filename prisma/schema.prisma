generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  name                String
  role                String   @default("user")
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id])
  // Set true quando admin cria/reseta — forca troca de senha no proximo login.
  mustChangePassword  Boolean  @default(false)
  // Permissoes granulares por modulo. Estrutura: { leads: ["read","write"], patients: ["read"], ... }
  // null = role decide (super_admin/clinic_admin/user). Usado em [USR-1] PR de RBAC.
  permissions         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clinicId])
}

model Clinic {
  id               String      @id @default(cuid())
  name             String
  kommoSubdomain   String      @unique
  kommoToken       String
  clinicorpUser       String?
  clinicorpToken      String?
  clinicorpBusinessId String?
  // Toggles de integração
  clinicorpAutoCreatePatient Boolean @default(false)
  clinicorpWebhookEnabled    Boolean @default(true)
  // Meta Ads (Marketing API - somente leitura)
  metaAccessToken    String?
  metaTokenExpiresAt DateTime?
  metaAdAccountId    String?
  // Google Ads (Marketing API - somente leitura)
  googleAdsRefreshToken  String?
  googleAdsCustomerId    String?
  pipelineId       String?
  stageAgendamento String?
  // Mapeamento ATENDIDO POR (Kommo) -> Dentist_PersonId (Clinicorp).
  // Estrutura: { "nome no kommo": 12345, ... }. Lookup case/whitespace insensitive em runtime.
  professionalMap  Json?
  // Timestamps das ultimas execucoes dos jobs periodicos (sync-clinicorp e match-leads).
  // Atualizados pelos workers no fim de cada execucao bem sucedida. Usados pelo dashboard
  // pra mostrar "Atualizado ha Xmin" via /api/sync/status.
  lastClinicorpSyncAt DateTime?
  lastMatchLeadsAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  users            User[]
  leads            Lead[]
  patients         Patient[]
  procedures       Procedure[]
  adCampaignData   AdCampaignData[]
}

model Lead {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  kommoLeadId     String
  name            String
  phone           String?
  email           String?
  // UTMs
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  // Canal de Prospeccao (Kommo custom field)
  canalProspeccao String?
  // Patient classification: true = first-time (acquisition), false = returning (retention)
  isNewPatient    Boolean?
  // Status
  channel         String    @default("organic") // "campaign" | "organic"
  kommoStatus     String?
  kommoPipelineId String?
  // Matching
  patientId       String?
  patient         Patient?  @relation(fields: [patientId], references: [id])
  // Timestamps
  kommoCreatedAt  DateTime?
  agendamentoAt   DateTime?
  // Appointment data from Kommo custom fields
  appointmentDate     String?
  appointmentTime     String?
  appointmentProfId   String?
  clinicorpAppointmentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clinicId, kommoLeadId])
  @@index([clinicId, channel])
  @@index([clinicId, utmCampaign])
  @@index([clinicId, isNewPatient])
}

model Patient {
  id                 String      @id @default(cuid())
  clinicId           String
  clinic             Clinic      @relation(fields: [clinicId], references: [id])
  clinicorpPatientId String?
  name               String
  phone              String?
  cpf                String?
  // UTMs herdadas do lead
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  // Canal de prospeccao herdado do lead
  canalProspeccao    String?
  // Relações
  leads              Lead[]
  procedures         Procedure[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([clinicId, clinicorpPatientId])
  @@index([clinicId, phone])
}

model Procedure {
  id                   String    @id @default(cuid())
  clinicId             String
  clinic               Clinic    @relation(fields: [clinicId], references: [id])
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id])
  clinicorpProcedureId String?
  name                 String
  // value = FinalAmount do Clinicorp (preco bruto do procedure, sem desconto da Estimate)
  value                Float
  // [DASH-3] discountAmount = parcela do Estimate.DiscountAmount rateado proporcional
  // ao FinalAmount entre os procedures Aprovados da mesma Estimate. Receita liquida
  // ("Venda" no Clinicorp) = value - discountAmount.
  discountAmount       Float     @default(0)
  // status interno legado: "pending" | "approved" | "completed" | "cancelled"
  // Mapeado a partir do est.Status (Estimate-level) — granularidade errada pra
  // dashboards. Mantido por backwards-compat de leitura.
  status               String    @default("pending")
  // [DASH-3] Status do procedure-level (Aprovado, Orçamento, Executado, Cancelado...).
  // Vem de proc.StatusDescription do Clinicorp. Granularidade correta — uma estimate
  // APPROVED pode ter procs com statusDescription diferente.
  statusDescription    String?
  // [DASH-3] proc.PaymentAccounted == "X" no Clinicorp = pagamento contabilizado.
  paymentAccounted     Boolean   @default(false)
  // [DASH-3] proc.Deleted == "X" no Clinicorp. Pulamos esses procs no sync.
  deleted              Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, statusDescription])
  @@index([patientId])
}

model AdCampaignData {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  platform     String   // "meta" | "google"
  campaignId   String   // ID da campanha na plataforma
  campaignName String
  date         DateTime @db.Date
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spend        Float    @default(0)
  currency     String   @default("BRL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clinicId, platform, campaignId, date])
  @@index([clinicId, date])
  @@index([clinicId, campaignName])
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String   // "kommo" | "clinicorp"
  event     String
  payload   Json
  status    String   @default("received") // "received" | "processed" | "error"
  error     String?
  // Nullable: webhooks chegam antes de identificar a clinica; e legacy entries
  // pre-[SEC-2.1] nao tem esse campo. Quando identificavel, populado pelo handler.
  clinicId  String?
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
}
